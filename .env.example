# Server-only Featherless credentials. Never prefix these with VITE_.
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=Qwen/Qwen3-32B

# Browser-visible adapter selection.
VITE_USE_MOCK_AGENT=false
VITE_USE_MOCK_MARKET_SIGNALS=true
VITE_USE_MOCK_CALENDAR=true
VITE_USE_MOCK_VOICE=true
VITE_API_BASE_URL=/api
